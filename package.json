{
  "name": "project-hub",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectHub — Единая десктопная панель управления проектами с обвязкой ProjectTemplate (Backlog.md, Git, RAG, MCP, Dev-окружение)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --win",
    "setup": "node scripts/setup.mjs",
    "index-docs": "node scripts/rag/index-docs.mjs",
    "rag-server": "node scripts/rag/rag-server.mjs",
    "rag-search": "node scripts/rag/search-cli.mjs",
    "env-server": "node scripts/env/env-server.mjs",
    "sync-rules": "node scripts/sync-agent-rules.mjs",
    "bootstrap": "node scripts/bootstrap/bootstrap.mjs",
    "lightrag-setup": "node scripts/lightrag/setup.mjs",
    "lightrag-index": "node scripts/lightrag/run.mjs index_docs.py",
    "lightrag-query": "node scripts/lightrag/run.mjs query.py",
    "lightrag-server": "node scripts/lightrag/lightrag-server.mjs",
    "web": "node scripts/web.mjs"
  },
  "build": {
    "appId": "com.projecthub.desktop",
    "productName": "ProjectHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/@lancedb/**",
      "**/apache-arrow/**"
    ],
    "portable": {
      "useZip": true
    }
  },
  "author": "ProjectHub Team",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^18.1.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
