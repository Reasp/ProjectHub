{
  "name": "project-hub",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectHub — Единая десктопная панель управления проектами с обвязкой ProjectTemplate (Backlog.md, Git, RAG, MCP, Dev-окружение)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint:docs": "node scripts/validate-docs.mjs && node scripts/rag/check-index.mjs",
    "check-index": "node scripts/rag/check-index.mjs",
    "test": "vitest run",
    "build": "node scripts/validate-docs.mjs && node scripts/rag/check-index.mjs --warn && npm run lint && npm run test && tsc && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "pack:win": "node scripts/pack-win.mjs",
    "pack:mac": "node scripts/pack-mac.mjs",
    "dist:win": "npm run build && electron-builder --win portable && node scripts/patch-exe-icon.mjs",
    "dist:mac": "node scripts/pack-mac.mjs --dist",
    "dist": "npm run build && electron-builder --win && node scripts/patch-exe-icon.mjs",
    "setup": "node scripts/setup.mjs",
    "index-docs": "node scripts/rag/index-docs.mjs",
    "rag-server": "node scripts/rag/rag-server.mjs",
    "rag-search": "node scripts/rag/search-cli.mjs",
    "env-server": "node scripts/env/env-server.mjs",
    "sync-rules": "node scripts/sync-agent-rules.mjs",
    "bootstrap": "node scripts/bootstrap/bootstrap.mjs",
    "lightrag-setup": "node scripts/lightrag/setup.mjs",
    "lightrag-index": "node scripts/lightrag/run.mjs index_docs.py",
    "lightrag-query": "node scripts/lightrag/run.mjs query.py",
    "lightrag-server": "node scripts/lightrag/lightrag-server.mjs",
    "mcp-server": "node scripts/mcp-server.mjs",
    "web": "node scripts/web.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-bundle": "node scripts/check-bundle.mjs"
  },
  "build": {
    "appId": "com.projecthub.desktop",
    "productName": "ProjectHub",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ProjectHub использует микрофон для голосового управления и ассистента."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/@lancedb/**",
      "**/apache-arrow/**",
      "**/node-pty/**"
    ],
    "portable": {
      "useZip": true
    }
  },
  "author": "ProjectHub Team",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^18.1.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  }
}
